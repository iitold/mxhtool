{
  "name": "itold-content-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pipeline": "tsx scripts/main.ts",
    "pipeline:force": "tsx scripts/main.ts --force",
    "setup": "tsx scripts/setup.ts",
    "render:test": "tsx scripts/render-test.ts",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:preview": "npm run pages:build && npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "pages:deploy": "npm run pages:build && npx wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "highlight.js": "11.10.0",
    "lucide-react": "^0.451.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.12.1",
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "playwright": "1.47.2",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vercel": "^37.14.0",
    "wrangler": "^3.80.0"
  }
}
