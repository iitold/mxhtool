# ─────────────────────────────────────────────────────────────
# IT OLD Content Factory — Environment variables
# Copy to .env (local) and set the same keys as GitHub Actions secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://qntfywlfodbpguxdsemi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=media

# AI — Gemini (https://aistudio.google.com/apikey). Multiple keys = comma separated.
GEMINI_API_KEYS=key1,key2
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Telegram notifications (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_PRIVACY=SELF_ONLY

# Facebook Page
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_APP_SECRET=

# Pipeline
TZ=Asia/Ho_Chi_Minh
POST_TIMES=06:45,12:15,19:30
MAX_POSTS_PER_DAY=5
DEDUP_DAYS=90
SLIDES_MIN=3
SLIDES_MAX=5
RENDER_SCALE=2
VERIFY_CODE=false

# Security
CRON_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com

# GitHub dispatch (admin "force post" button → triggers Actions workflow).
# NOTE: these are for the WEB APP (Cloudflare env / admin Credentials UI),
# NOT GitHub Actions secrets — GitHub blocks secret names starting with "GITHUB_".
GITHUB_TOKEN=
GITHUB_REPO=iitold/mxhtool
GITHUB_WORKFLOW=pipeline.yml
GITHUB_BRANCH=main

# Cloudflare Pages deploy (repo secrets for the deploy-pages workflow)
# Create an API token with "Cloudflare Pages: Edit" permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Public site URL (used for OAuth redirects, e.g. TikTok/Threads)
SITE_URL=https://mxhtool.pages.dev
